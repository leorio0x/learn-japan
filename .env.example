# Salin menjadi .env lalu sesuaikan nilainya.
# File .env sudah di-ignore git dan dipakai oleh docker-compose.yml.

# Username Docker Hub tempat image di-push oleh CI.
DOCKERHUB_USERNAME=

# Direktori data JSON di VPS (di luar repo). Lokal boleh dikosongkan (default ./data).
DATA_DIR=/opt/learn-japan-data

# Password untuk mengakses fitur CRUD (kelola data). Kosongkan untuk memakai default.
# Digunakan hanya di sisi backend, tidak pernah dikirim ke browser.
CRUD_PASSWORD=

# Kunci penanda tangan token sesi CRUD. Kosongkan untuk digenerate acak saat start
# (token lama tidak berlaku setelah restart).
SESSION_SECRET=
